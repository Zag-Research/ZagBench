'From Pharo13.1.0SNAPSHOT of 29 July 2025 [Build information: Pharo-13.1.0+SNAPSHOT.build.695.sha.6103a275f1acabf1b4db65b335ed82e6dd9f1e87 (64 Bit)] on 19 December 2025 at 5:58:17.642 pm'!Object subclass: #FibonacciMemoized	instanceVariableNames: ''	classVariableNames: ''	package: 'ZagBench-FibonacciMemoized'!!FibonacciMemoized methodsFor: 'as yet unclassified' stamp: '2025-12-19T17:57:57.645-05:00'!fibMemo: n    "Return cached result if exists, otherwise calculate and cache"    | result cache|      cache := Dictionary new.    n <= 1 ifTrue: [ ^ n ].      cache at: n ifPresent: [ :value | ^ value ].        result := (self fibMemo: n - 1) + (self fibMemo: n - 2).    cache at: n put: result.        ^ result.! !